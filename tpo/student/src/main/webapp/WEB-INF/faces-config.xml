<?xml version="1.0" encoding="UTF-8"?>

<faces-config xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_1.xsd"
	version="2.1">
	<application>
		<el-resolver>
			org.springframework.web.jsf.el.SpringBeanFacesELResolver
		</el-resolver>
		<locale-config>
			<default-locale>en</default-locale>
			<supported-locale>de</supported-locale>
			<supported-locale>fr</supported-locale>
			<supported-locale>es</supported-locale>
			<supported-locale>ru</supported-locale>
		</locale-config>
	</application>

	<validator>
		<validator-id>EnrollmentNumberValidator</validator-id>
		<validator-class>com.validator.EnrollmentNumberValidator
		</validator-class>
	</validator>
	<validator>
		<validator-id>CollegeValidator</validator-id>
		<validator-class>com.validator.CollegeValidator
		</validator-class>
	</validator>
	<validator>
		<validator-id>EnrollmentNumberValidatorInvert</validator-id>
		<validator-class>com.validator.EnrollmentNumberValidatorInvert
		</validator-class>
	</validator>
	<validator>
		<validator-id>PercentValidator</validator-id>
		<validator-class>com.validator.PercentValidator</validator-class>
	</validator>
	<validator>
		<validator-id>EmailValidator</validator-id>
		<validator-class>com.validator.EmailValidator</validator-class>
	</validator>

	<validator>
		<validator-id>ChaptaValidator</validator-id>
		<validator-class>com.validator.ChaptaValidator
		</validator-class>
	</validator>

	<validator>
		<validator-id>PasswordValidator</validator-id>
		<validator-class>com.validator.PasswordValidator</validator-class>
	</validator>

	<navigation-rule>
		<navigation-case>
			<from-outcome>sessionExpiredAction</from-outcome>
			<to-view-id>/sessionInvalidated.xhtml</to-view-id>
			<redirect></redirect>
		</navigation-case>
		<navigation-case>
			<from-outcome>studentExamList</from-outcome>
			<to-view-id>/student/studentExamList.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>resultList</from-outcome>
			<to-view-id>/student/resultList.xhtml</to-view-id>
			<redirect></redirect>
		</navigation-case>
		<navigation-case>
			<from-outcome>calendar</from-outcome>
			<to-view-id>/student/calendar.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>studentRegistration</from-outcome>
			<to-view-id>/xhtml/ui/newStudent.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>studentHomePageT0</from-outcome>
			<to-view-id>/xhtml/newStudent.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>studentHomePageT1</from-outcome>
			<to-view-id>/studentTemplate/studentHome.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>studentHomePageT2</from-outcome>
			<to-view-id>/studentTemplateTheme2/studentHome.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>studentHomePageT3</from-outcome>
			<to-view-id>/studentTemplateTheme3/studentHome.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>hallTicketListdownload</from-outcome>
			<to-view-id>/student/downloadHallTicketList.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/login/login.xhtml</to-view-id>
			<redirect></redirect>
		</navigation-case>
	</navigation-rule>
</faces-config>
