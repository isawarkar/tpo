<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="com.hibernate.Company" table="company">
		<id name="companyID" type="java.lang.Integer">
			<column name="companyID" length="6" />
			<generator class="assigned" />
		</id>
		<property name="companyname" type="java.lang.String">
			<column name="companyname" length="150" />
		</property>
		<property name="dateofvisit" type="java.util.Date">
			<column name="dateofvisit" />
		</property>
		<property name="profile" type="java.lang.String">
			<column name="profile" length="5000" />
		</property>
		<property name="domain" type="java.lang.String">
			<column name="domain" length="500" />
		</property>
		<property name="website" type="java.lang.String">
			<column name="website" length="500" />
		</property>
		<property name="linkedIn" type="java.lang.String">
			<column name="linkedIn" length="500" />
		</property>
		<property name="twiter" type="java.lang.String">
			<column name="twiter" length="500" />
		</property>
		<property name="glassdoor" type="java.lang.String">
			<column name="glassdoor" length="500" />
		</property>
		<property name="facebook" type="java.lang.String">
			<column name="facebook" length="500" />
		</property>
		<property name="email" type="java.lang.String">
			<column name="email" length="100" />
		</property>
		<property name="remarks" type="java.lang.String">
			<column name="remarks" length="50" />
		</property>
		<property name="createdBy" type="java.lang.String">
			<column name="createdBy" length="20" not-null="true" />
		</property>
		<property name="packageOffering" type="java.lang.String">
			<column name="packageOffering" length="50" />
		</property>
	</class>
</hibernate-mapping>
