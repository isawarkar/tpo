        <property name="avgbe1year" type="java.lang.Double">
            <column name="avgbe1year" precision="4" />
        </property>
        <property name="avgbe2year" type="java.lang.Double">
            <column name="avgbe2year" precision="4" />
        </property>
        <property name="avgbe3year" type="java.lang.Double">
