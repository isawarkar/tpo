spring:
  application:
    name: student

  main:
    allow-bean-definition-overriding: true

  profiles:
    active: prod

management:
  security:
    enabled: false

logging:
  level:
    root: INFO

---

spring:
  profiles: dev

server:
  address: 0.0.0.0
  port: 8080

eureka:
  client:
    healthcheck:
      enabled: true

    serviceUrl:
      defaultZone: http://host.docker.internal:8761/eureka

  instance:
    statusPageUrl: http://host.docker.internal:8081/student/actuator/health
    healthCheckUrl: http://host.docker.internal:8081/student/actuator/health
    homePageUrl: http://host.docker.internal:8081/student/
    ip-address: ${server.address}
    nonSecurePort: 8080
    nonSecurePortEnabled: true
    preferIpAddress: true

---

spring:
  profiles: prod

server:
  address: 0.0.0.0
  port: 8080

eureka:
  client:
    healthcheck:
      enabled: true

    serviceUrl:
      defaultZone: http://100.24.40.147:8761/eureka

  instance:
    statusPageUrl: https://student.fresherbuddy.in/student/actuator/health
    healthCheckUrl: https://student.fresherbuddy.in/student/actuator/health
    homePageUrl: https://student.fresherbuddy.in/student/
    ip-address: ${server.address}
    nonSecurePort: 8080
    nonSecurePortEnabled: true
    preferIpAddress: true
