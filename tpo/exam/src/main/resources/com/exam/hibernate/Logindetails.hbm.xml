<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.hibernate.Logindetails" table="logindetails" >
        <id name="userName" type="java.lang.String">
            <column name="userName" length="20" />
            <generator class="assigned" />
        </id>
        <property name="password" type="java.lang.String">
            <column name="password" length="100" not-null="true"/>
        </property>
        <property name="role" type="java.lang.String">
            <column name="role" length="1" not-null="true" />
        </property>
        <property name="active" type="java.lang.Boolean">
            <column name="active" not-null="true" />
        </property>
        <property name="lastLogin" type="java.util.Date">
            <column name="lastLogin" length="19" not-null="true" />
        </property>
        <property name="loginAttempt" type="java.lang.Integer">
            <column name="loginAttempt" not-null="true" />
        </property>
        <property name="validTill" type="java.util.Date">
            <column name="validTill" length="19" not-null="true" />
        </property>
         <property name="createdBy" type="java.lang.String">
            <column name="createdBy" length="20" not-null="true" />
        </property>
         <property name="logoDisplay" type="java.lang.Boolean">
            <column name="logoDisplay" not-null="true" />
        </property>
        <property name="ui" type="java.lang.Boolean">
            <column name="ui" not-null="true" />
        </property>
        <one-to-one cascade="delete-orphan" name="userdetails" class="com.hibernate.Userdetails"></one-to-one>
  		<set cascade="delete-orphan" name="colleges" inverse="true">
            <key>
                <column name="userName" />
            </key>
            <one-to-many  class="com.hibernate.College" />
        </set>
  	 </class>
</hibernate-mapping>
