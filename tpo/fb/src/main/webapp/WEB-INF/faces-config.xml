<?xml version="1.0" encoding="UTF-8"?>

<faces-config xmlns="http:/java.sun.com/xml/ns/javaee"
	xmlns:xsi="http:/www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http:/java.sun.com/xml/ns/javaee http:/java.sun.com/xml/ns/javaee/web-facesconfig_2_1.xsd"
	version="2.1">
	<application>
		<el-resolver>
			org.springframework.web.jsf.el.SpringBeanFacesELResolver
		</el-resolver>
		<locale-config>
			<default-locale>en</default-locale>
			<supported-locale>de</supported-locale>
			<supported-locale>fr</supported-locale>
			<supported-locale>es</supported-locale>
			<supported-locale>ru</supported-locale>
		</locale-config>
	</application>

	<validator>
		<validator-id>NewsLetterEmailValidator</validator-id>
		<validator-class>tpo.validator.NewsLetterEmailValidator
		</validator-class>
	</validator>
	<validator>
		<validator-id>EmailValidator</validator-id>
		<validator-class>tpo.validator.EmailValidator</validator-class>
	</validator>
	<validator>
		<validator-id>PasswordValidator</validator-id>
		<validator-class>tpo.validator.PasswordValidator</validator-class>
	</validator>
	<validator>
		<validator-id>UserNameValidator</validator-id>
		<validator-class>tpo.validator.UserNameValidator
		</validator-class>
	</validator>
	
	<validator>
		<validator-id>EnrollmentNumberValidator</validator-id>
		<validator-class>tpo.validator.EnrollmentNumberValidator
		</validator-class>
	</validator>
	<validator>
		<validator-id>EnrollmentNumberValidatorInvert</validator-id>
		<validator-class>tpo.validator.EnrollmentNumberValidatorInvert
		</validator-class>
	</validator>
	<validator>
		<validator-id>CollegeValidator</validator-id>
		<validator-class>tpo.validator.CollegeValidator</validator-class>
	</validator>
	<validator>
		<validator-id>PercentValidator</validator-id>
		<validator-class>tpo.validator.PercentValidator</validator-class>
	</validator>
	<validator>
		<validator-id>ChaptaValidator</validator-id>
		<validator-class>tpo.validator.ChaptaValidator
		</validator-class>
	</validator>

	<navigation-rule>
		<navigation-case>
			<from-outcome>sessionExpiredAction</from-outcome>
			<to-view-id>/sessionInvalidated.xhtml</to-view-id>
			<redirect></redirect>
		</navigation-case>
		<navigation-case>
			<from-outcome>CCPHomePage</from-outcome>
			<to-view-id>/index.xhtml</to-view-id>
			<redirect></redirect>
		</navigation-case>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/index.xhtml</to-view-id>
			<redirect></redirect>
		</navigation-case>
		 <navigation-case>
			<from-outcome>studentRegistration</from-outcome>
			<to-view-id>/xhtml/ui/newStudent.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>studentHomePageT0</from-outcome>
			<to-view-id>/xhtml/newStudent.xhtml</to-view-id>
		</navigation-case>
		<!-- Admin -->
		<navigation-case>
			<from-outcome>adminDashboard</from-outcome>
			<to-view-id>/adminTemplate/adminDashboard.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>adminDashboardNew</from-outcome>
			<to-view-id>/adminTemplateNew/pages/adminDashboard.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>mainTestNewWindow</from-outcome>
			<to-view-id>/xhtml/testOpener.jsp</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>effortsList</from-outcome>
			<to-view-id>/adminTemplateNew/ets/effortsList.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>effortsListReport</from-outcome>
			<to-view-id>/adminTemplateNew/ets/effortsListReport.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>projectList</from-outcome>
			<to-view-id>/adminTemplateNew/ets/projectList.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>moduleList</from-outcome>
			<to-view-id>/adminTemplateNew/ets/moduleList.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
</faces-config>
